# compass-app environment — copy to .env.local and fill in. .env.local is gitignored.
# On a new machine, the easiest path is to copy your existing .env.local over; this file
# documents every key the app reads.

# ── Supabase (the app's database — point at the SAME project to keep your data) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic (AI actions: intake, epics, research, refine, triage) ──
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# ── Atlassian (Jira write-path + Confluence docs). Use a CLASSIC API token (ATATT3… prefix). ──
ATLASSIAN_BASE_URL=https://your-org.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=your-atlassian-api-token
JIRA_PROJECT=KAN

# ── Microsoft Graph (only if an engagement uses Teams/SharePoint docs) — optional ──
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ── Real orchestrator Build/Fix (optional) — path to the compass framework repo ──
# COMPASS_REPO=/absolute/path/to/compass
