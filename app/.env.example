# compass-app environment — copy to .env.local and fill in. .env.local is gitignored.
# On a new machine, the easiest path is to copy your existing .env.local over; this file
# documents every key the app reads.

# ── Supabase (the app's database — point at the SAME project to keep your data) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic (AI actions: intake, epics, research, refine, triage) ──
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Which host runs an agent turn. Flip the digit.
#   0 (or unset / api / false) — the metered Anthropic API
#   1 (or cli / true)          — the logged-in `claude` binary, billing the subscription
#
# CLI is local/self-hosted only: a serverless function has no binary and no interactive login.
# NOT IMPLEMENTED YET — 1 halts with that reason rather than silently using the API, so a run
# never bills you when you asked it not to.
#
# Note an unset ANTHROPIC_API_KEY does NOT mean no credentials — the SDK also resolves
# ANTHROPIC_AUTH_TOKEN, an `ant auth login` profile, and WIF. Every one of those is METERED.
COMPASS_CLAUDE_HOST=0

# ── Atlassian (Jira write-path + Confluence docs). Use a CLASSIC API token (ATATT3… prefix). ──
ATLASSIAN_BASE_URL=https://your-org.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=your-atlassian-api-token
JIRA_PROJECT=KAN

# ── Microsoft Graph (only if an engagement uses Teams/SharePoint docs) — optional ──
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ── Real orchestrator Build/Fix (optional) — path to the compass framework repo ──
# COMPASS_REPO=/absolute/path/to/compass

# Encrypts credential columns at rest. Generate: openssl rand -base64 32
COMPASS_SECRET_KEY=
