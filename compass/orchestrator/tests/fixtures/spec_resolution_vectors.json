        {
          "path": "agents/x.md",
          "org_id": "default",
          "engagement_id": null,
          "content": "ORG"
        },
        {
          "path": "agents/x.md",
          "org_id": null,
          "engagement_id": "e2",
          "content": "ENG2"
        }
      ],
      "engagement": "e1",
      "path": "agents/x.md",
      "expect": {
        "content": "ORG",
        "tier": "org"
      }
    },
    {
