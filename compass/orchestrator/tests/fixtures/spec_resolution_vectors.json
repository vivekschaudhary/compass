{
  "_why": "Tier resolution is implemented twice \u2014 app/app/lib/specs.ts (resolveSpecFromTable, templateFor, resolveActor) and compass/orchestrator/spec_source.py. These cases pin the rules so a change to either has to change this file. Run by test_spec_source.py; the TS side should assert the same cases.",
  "spec": [
    {
      "name": "engagement override beats org default",
      "rows": [
        {
          "path": "agents/x.md",
          "org_id": "default",
          "engagement_id": null,
          "content": "ORG"
        },
        {
          "path": "agents/x.md",
          "org_id": null,
          "engagement_id": "e1",
          "content": "ENG"
        }
      ],
      "engagement": "e1",
      "path": "agents/x.md",
      "expect": {
        "content": "ENG",
        "tier": "engagement"
      }
    },
    {
      "name": "another engagement's override is ignored",
